<h2><%= titulo %></h2>

<% if (errores && errores.length > 0) { %>
  <ul class="errores">
    <% errores.forEach(function(e) { %>
      <li><%= e %></li>
    <% }); %>
  </ul>
<% } %>

<form method="POST">
  <div class="campo">
    <label for="estudiante">Estudiante:</label>
    <input type="text" id="estudiante" name="estudiante" required value="<%= datos.estudiante %>">
  </div>

  <div class="campo">
    <label for="email">Email:</label>
    <input type="email" id="email" name="email" required value="<%= datos.email %>">
  </div>

  <div class="campo">
    <label for="sala">Sala:</label>
    <select id="sala" name="sala">
      <% salasPermitidas.forEach(function(sala) { %>
        <option value="<%= sala %>" <%= sala === datos.sala ? 'selected' : '' %>><%= sala %></option>
      <% }); %>
    </select>
  </div>

  <div class="campo">
    <label for="fecha">Fecha:</label>
    <input type="date" id="fecha" name="fecha" required value="<%= datos.fecha %>">
  </div>

  <div class="campo">
    <label for="turno">Turno:</label>
    <select id="turno" name="turno">
      <% turnosPermitidos.forEach(function(turno) { %>
        <option value="<%= turno %>" <%= turno === datos.turno ? 'selected' : '' %>><%= turno %></option>
      <% }); %>
    </select>
  </div>

  <div class="campo">
    <label for="personas">Personas:</label>
    <input type="number" id="personas" name="personas" min="1" max="6" required value="<%= datos.personas %>">
  </div>

  <button type="submit" class="btn-submit"><%= titulo %></button>
  <a href="/reservas" class="btn-cancel">Cancelar</a>
</form>