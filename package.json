{
  "name": "tp-10-salas-consultas-mongodb",
  "version": "1.0.0",
  "description": "Trabajo practico 10 - Consultas de reservas de salas (Express 5 + Mongoose + MongoDB Atlas)",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "actualizar": "node --env-file=.env scripts/actualizar-reserva.js",
    "eliminar": "node --env-file=.env scripts/eliminar-reserva.js",
    "crear": "node --env-file=.env scripts/crear-reserva.js",
    "listar": "node --env-file=.env scripts/listar-reservas.js",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src scripts tests",
    "format:check": "prettier --check src scripts tests",
    "lint": "eslint src scripts tests",
    "check": "npm run format:check && npm run lint",
    "comprobar-conexion": "node --env-file=.env scripts/comprobar-conexion.js"
  },
  "license": "ISC",
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
